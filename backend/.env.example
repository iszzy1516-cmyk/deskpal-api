# Copy to .env and fill in. Never commit the real .env.

# Database. For local dev without Docker you can use:
#   DATABASE_URL=sqlite:///./deskpal.db
DATABASE_URL=postgresql+psycopg2://deskpal:deskpal@localhost:5432/deskpal

# Redis (used for rate limiting when available; falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# Secret key for signing JWTs. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# CORS — comma separated origins, e.g. http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# LLM provider: stub | ollama | openai
# Local-first: "ollama" runs Qwen on your own machine (no keys, no cost,
# documents never leave the box).
CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
# Embeddings: empty = stub (hash-based, fine for dev/tests). For real semantic
# retrieval: ollama pull nomic-embed-text, then set:
# OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_MODEL=

# Cloud fallback (only used when CHAT_PROVIDER=openai):
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Uploads
MAX_UPLOAD_MB=10
STORAGE_DIR=./storage
